APP_ENV=development
APP_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SESSION_NAME=pharmacy_session
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmacy
DB_USER=root
DB_PASSWORD=

# Outgoing email (PHPMailer SMTP). Keep real credentials in .env; never commit them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Pharmacy

# Hesed Technologies / mShastra SMS gateway
SMS_API_URL=https://mshastra.com/sendsms_api_json.aspx
SMS_PROFILE_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
